{
  "name": "shopping-list-api",
  "version": "1.0.0",
  "description": "A REST API for managing a shopping list, built with Node.js and TypeScript using the built-in http module.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "nodemon" : "^3.1.7",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
